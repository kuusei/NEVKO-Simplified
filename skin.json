  "Conditions": {
    "DRIVER = 1": {
      "description": "",
      "default": "",
      "tab": "通用",
      "values": {
        "": {}
      }
    },
    "头像圆角": {
      "description": "三种头像圆角预设",
      "default": "圆角方形",
      "tab": "通用",
      "values": {
        "直角": {
          "TargetCss": {
            "affects": [".*"],
            "src": "General/Rounding Avatars/Sharp.css"
          }
        },
        "圆角方形": {
          "TargetCss": {
            "affects": [".*"],
            "src": "General/Rounding Avatars/Rounded Square.css"
          }
        },
        "圆形": {
          "TargetCss": {
            "affects": [".*"],
            "src": "General/Rounding Avatars/Circle.css"
          }
        }
      }
    },
