  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetJs": "Misc/Category Settings Script/TitleCategory.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Misc/Category Settings Script/TitleCategory.js"
    },
  
    {
      "MatchRegexString": ".*",
      "TargetJs": "webkit.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetCss": "Misc/Accents Code/accents-config.css"
    },

    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Refresh UI/Refresh Header/Header Code.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Main Refresh UI/Refresh Header/Header Script.js"
    },
    {
      "MatchRegexString": "^(Steam|Library Supernav)$",
      "TargetJs": "Main Refresh UI/Refresh Header/Hidden Games Menu.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Refresh UI/Refresh Library/Library Code.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Main Refresh UI/Refresh Library/Collection Tags.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Refresh UI/Refresh Library/Perfect Achievement Badge.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Main Refresh UI/Refresh Library/Perfect Achievement Badge.js"
    },
    {
      "MatchRegexString": "^Steam$",
