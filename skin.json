    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Refresh UI/Refresh Settings/Millennium Code.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Misc/Remove Stuff/RemoveShadow.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Misc/Remove Stuff/RemoveUseless.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Misc/Remove Stuff/Resizer Library.css"
    },
    {
      "MatchRegexString": ".ModalDialogPopup",
      "TargetCss": "Misc/Fix Millenium Stuff/SVGLocation.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Misc/Return Old Style Tooltips/Legacy Tooltip.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Misc/OLD Accents Code/Main Steam Elements.css"
    },
    {
